<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/maze_menu_bg">

    <ImageView
        android:id="@+id/splashLogoImageView"
        android:layout_width="280dp"
        android:layout_height="166dp"
        android:layout_marginTop="84dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/maze_menu_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/progressContainer"
        android:layout_width="220dp"
        android:layout_height="20dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_splash_progress_track"
        android:padding="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/progressBarFillView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_splash_progress_fill"
            android:pivotX="0"
            android:scaleX="0" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
