<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="7dp" />
            <corners android:radius="3.5dp" />
            <solid android:color="#55FFFFFF" />
            <stroke android:width="1dp" android:color="#74360F" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="7dp" />
                <corners android:radius="3.5dp" />
                <solid android:color="#00000000" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="7dp" />
                <corners android:radius="3.5dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#FFE082"
                    android:endColor="#FFB300" />
                <stroke android:width="1dp" android:color="#74360F" />
            </shape>
        </clip>
    </item>
</layer-list>
